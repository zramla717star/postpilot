# PostPilot — copy to .env and fill in ONLY after TikTok approval.
# NEVER put a real client key, client secret, or any password in
# code, screenshots, or chat. These values are placeholders.
# Do NOT commit a real .env file (see .gitignore).

# "true" only after TikTok approval AND a review of the real API call.
# Default (empty / anything else) = sandbox / dry-run mode.
APPROVED=

# TikTok developer app credentials (from developers.tiktok.com,
# shown masked in the dashboard — copy them here yourself).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a Redirect URI configured in the TikTok app
# (Login Kit, Web). Example shape only — use your real hosted URL:
# TIKTOK_REDIRECT_URI=https://your-domain.example/auth/callback
TIKTOK_REDIRECT_URI=

# Public base URL of this app once hosted (used in docs/links).
APP_BASE_URL=

# Local run settings.
HOST=127.0.0.1
PORT=8000
SCHEDULER_INTERVAL_SECONDS=60
